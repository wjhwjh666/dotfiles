{
  // =======================================================
  //  统一调度中心 — 九个扩展、三条防线、互不打架
  //  原则: Python→Ruff独占 | JS/TS→Prettier格式+ESLint质量 | GitLens→追溯
  // =======================================================

  // ── 全局基础 ─────────────────────────────────
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",          // 不由 editor 统一修 — 各语言自己管
    "source.fixAll.ruff": "explicit",  // Python → Ruff
    "source.fixAll.eslint": "explicit" // JS/TS → ESLint
  },
  "files.autoSave": "off",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ── 防线一: Python — Ruff 独占（格式化 + lint 一把梭）─────
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.enable": true,
  "ruff.lint.enable": true,
  "ruff.format.enable": true,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.configuration": "~/.ruff.toml",

  // ── 防线二: JS/TS — Prettier 格式化 + ESLint 代码质量 ─────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },

  // Prettier 常规地盘
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },

  // Prettier 全局设置
  "prettier.configPath": "~/.prettierrc.json",
  "prettier.requireConfig": false,  // 无项目配置时 fallback 到全局

  // ESLint 全局设置 — 只做 quality，不碰 formatting
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.options": {
    "overrideConfigFile": "C:\\Users\\王嘉浩\\eslint.config.js"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  // 禁用 ESLint 中与 Prettier 冲突的规则的 UI 提示
  "eslint.rules.customizations": [],

  // ── 防线三: Git 追溯 — GitLens ─────────────────
  "gitlens.currentLine.enabled": true,
  "gitlens.codeLens.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.blame.format": "${author|10} • ${date|YYYY-MM-DD} • ${message|50?}",
  "gitlens.defaultDateStyle": "absolute",
  "gitlens.plusFeatures.enabled": false,

  // ── Claude Code ─────────────────────────────────
  "claudeCode.initialPermissionMode": "plan",
  "claudeCode.showFileChangesOnEdit": true,

  // ── 其他语言不指定 formatter（由项目自行覆盖）────
  "[shellscript]": { "files.trimTrailingWhitespace": true },
  "[dockerfile]": { "files.trimTrailingWhitespace": true },

  // ── 排除干扰目录 ─────────────────────────────────
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.git": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true
  }
}
